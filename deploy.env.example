# ==============================================================================
# SISTEMA DE GESTIÓN ESCOLAR V2 — VARIABLES DE ENTORNO DE DESPLIEGUE
# ==============================================================================
# Copie este archivo como .env para configurar su entorno local o productivo:
# cp deploy.env.example .env
# NUNCA suba el archivo .env con contraseñas o secretos reales a Git.
# ==============================================================================

# ── 1. BASE DE DATOS POSTGRESQL ───────────────────────────────────────────────
POSTGRES_DB=sistema_academico
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_super_secret_password_change_me
DB_PORT=5432

# ── 2. BACKEND SPRING BOOT (JAVA 21) ──────────────────────────────────────────
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Secreto criptográfico HMAC-SHA256 para firma y validación de tokens JWT
# IMPORTANTE: En producción genere un secreto de al menos 256 bits (64 caracteres hex)
# Generar con: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_HOURS=8

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200

# Bootstrap de administrador inicial (para primer arranque en contenedor nuevo)
SECURITY_BOOTSTRAP_ADMIN_ENABLED=true
SECURITY_ADMIN_USERNAME=admin
SECURITY_ADMIN_PASSWORD=Admin123*

# ── 3. FRONTEND ANGULAR SPA + REVERSE PROXY NGINX ─────────────────────────────
FRONTEND_PORT=80
